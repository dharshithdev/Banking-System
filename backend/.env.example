# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/banking_system

# Comma-separated allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Local development manager (set unique credentials outside local development)
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=ChangeMe-Local-Only-2026!

# Replace with a random secret of at least 32 characters in production
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
