# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/banking_system

# Comma-separated allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Set these unique credentials before running npm run seed.
SEED_MANAGER_NAME=Bank Manager
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Set a unique random secret. Startup explicitly rejects this example value.
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

# Email-based login verification (required unless explicitly disabled)
EMAIL_2FA_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=REPLACE_WITH_YOUR_SMTP_PASSWORD
SMTP_FROM=Bank Manager <no-reply@example.com>
